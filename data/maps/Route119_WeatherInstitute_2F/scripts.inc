Route119_WeatherInstitute_2F_EventScript_WeatherScientist::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_CASTFORM, Route119_WeatherInstitute_2F_EventScript_ScientistMentionWeather
	goto Route119_WeatherInstitute_2F_EventScript_ReceiveCastform
	end

Route119_WeatherInstitute_2F_Text_Grunt2Intro:
	.string "The INSTITUTE made a weather POKéMON.\p"
	.string "If it makes rain, it can make sparkling\n"
	.string "rain.$"

Route119_WeatherInstitute_2F_Text_Grunt2Defeat:
	.string "Spoiled by a kid!\p"
	.string "Like leaving the bottle open.$"

Route119_WeatherInstitute_2F_Text_Grunt2PostBattle:
	.string "Imagine it. Sparkling rain. Everywhere.\p"
	.string "TEAM AQUA's dream.$"

Route119_WeatherInstitute_2F_Text_Grunt3Intro:
	.string "We're TEAM AQUA! We show up wherever\n"
	.string "anything rare is found!\p"
	.string "Or bubbly.$"

Route119_WeatherInstitute_2F_Text_Grunt3Defeat:
	.string "You got me! Flat as a pancake.$"

Route119_WeatherInstitute_2F_Text_Grunt3PostBattle:
	.string "You don't get what TEAM AQUA wants.\p"
	.string "Carbonation. For everyone.$"

Route119_WeatherInstitute_2F_Text_Grunt5Intro:
	.string "Looking for the weather POKéMON too?\p"
	.string "No-no! Unless it comes with bubbles.$"

Route119_WeatherInstitute_2F_Text_Grunt5Defeat:
	.string "My POKéMON went flat!$"

Route119_WeatherInstitute_2F_Text_Grunt5PostBattle:
	.string "What we really want isn't here…\p"
	.string "It's a spring. A sparkling one.\p"
	.string "Ihihihi…$"

Route119_WeatherInstitute_2F_Text_ShellyIntro:
	.string "Ahahahaha!\p"
	.string "Meddling with TEAM AQUA?\p"
	.string "You drink still water, I bet.$"

Route119_WeatherInstitute_2F_Text_ShellyDefeat:
	.string "Ahahahaha! Disgustingly strong!\p"
	.string "And disgustingly hydrated!$"

Route119_WeatherInstitute_2F_Text_ShellyPostBattle:
	.string "Bad enough TEAM MAGMA puts hot sauce\n"
	.string "on everything. Now you?\p"
	.string "Go drink some tap water.$"

Route119_WeatherInstitute_2F_Text_TeamMagmaJustPassedBy:
	.string "We have a situation!\p"
	.string "A MAGMA mob just passed by. Heading to\n"
	.string "MT. PYRE!\p"
	.string "They smelled like chili.$"

Route119_WeatherInstitute_2F_Text_WeHaveToHurryToMtPyre:
	.string "What?! No more time here! To MT. PYRE!\p"
	.string "Ahahahaha! MAGMA, keep your sauce away\n"
	.string "from that ORB!$"

Route119_WeatherInstitute_2F_Text_ThanksPleaseTakePokemon:
	.string "Thanks! We're safe! Take this POKéMON.\p"
	.string "CASTFORM changes with the weather!\n"
	.string "SUN! RAIN! HAIL! SNOW!\p"
	.string "…Not SANDSTORM, though. Sorry, DARUDE.$"

@ Unused
Route119_WeatherInstitute_2F_Text_NoRoomForPokemon:
	.string "No room in your party? The weather isn't\n"
	.string "the only thing that's cloudy.$"

Route119_WeatherInstitute_2F_Text_PlayerReceivedCastform:
	.string "{PLAYER} received CASTFORM!\p"
	.string "Sandstorm.$"

Route119_WeatherInstitute_2F_Text_PokemonChangesWithWeather:
	.string "CASTFORM changes shape with the\n"
	.string "weather. It's a weather app you can\l"
	.string "throw at people.\p"
	.string "SANDSTORM? Nope. Does nothing.\n"
	.string "DUDUDUDUDU. Nothing.$"

Route119_WeatherInstitute_2F_Text_ChangingWeatherRidiculous:
	.string "I've researched rain for years. You\n"
	.string "know what's ridiculous? SANDSTORM is\l"
	.string "weather, but CASTFORM ignores it. Rude.$"

Route119_WeatherInstitute_2F_Text_GroudonWeather:
	.string "I track HOENN's weather.\p"
	.string "A drought has been recorded in {STR_VAR_1}.\p"
	.string "Could something be near {STR_VAR_1}…?\p"
	.string "Something that makes it very, very hot?$"

Route119_WeatherInstitute_2F_Text_KyogreWeather:
	.string "I track HOENN's weather.\p"
	.string "Heavy rain is falling over {STR_VAR_1}.\p"
	.string "Could something be near {STR_VAR_1}…?\p"
	.string "Something very, very wet?$"

Route119_WeatherInstitute_2F_Text_NoAbnormalWeather:
	.string "No more abnormal weather reports.\p"
	.string "A bit of rain now and then is a blessing.\p"
	.string "A bit. Not a flood.$"

