gText_NoticesGoldCard::
	.string "Th-that card…\n"
	.string "Is that… The GOLD CARD?!\p"
	.string "It's so shiny! The four stars are\n"
	.string "sparkling!\p"
	.string "I've seen plenty of SILVER CARDS, but\n"
	.string "{PLAYER}, you're the first TRAINER with\l"
	.string "a GOLD CARD!\p"
	.string "Please, {PLAYER}, allow me the honor of\n"
	.string "healing your POKéMON! You skip the line.\l"
	.string "Forever.$"

gText_YouWantTheUsual::
	.string "{PLAYER}! My favorite regular!\n"
	.string "The usual, right?$"

gText_IllTakeYourPkmn2::
	.string "Okay, I'll take your POKéMON for a few\n"
	.string "seconds.$"

gText_ThankYouForWaiting::
	.string "Thank you for waiting.$"

gText_WeHopeToSeeYouAgain2::
	.string "See you next time! And there's always a\n"
	.string "next time.$"
