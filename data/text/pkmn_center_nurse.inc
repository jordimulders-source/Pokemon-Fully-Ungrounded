gText_WouldYouLikeToRestYourPkmn::
	.string "Welcome to the POKéMON CENTER.\p"
	.string "We fix your POKéMON. No questions\n"
	.string "asked. No insurance needed.\p"
	.string "Would you like to rest your POKéMON?$"

gText_IllTakeYourPkmn::
	.string "Okay, I will take them for a moment.\n"
	.string "Do not ask what happens in the back.$"

gText_RestoredPkmnToFullHealth::
	.string "Thank you for waiting.\p"
	.string "Your POKéMON are back to full health.\n"
	.string "Try not to break them again.$"

gText_WeHopeToSeeYouAgain::
	.string "We hope to see you again! We know we\n"
	.string "will.$"

gText_WelcomeCutShort::
	.string "Welcome to the POKéMON CENTER.\p"
