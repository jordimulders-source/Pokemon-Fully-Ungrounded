EverGrandeCity_HallOfFame_EventScript_SetGameClearFlags::
	special SetChampionSaveWarp
	setflag FLAG_IS_CHAMPION
	call EverGrandeCity_HallOfFame_EventScript_ResetDefeatedEventLegendaries
	call_if_eq VAR_FOSSIL_MANIAC_STATE, 0, EverGrandeCity_HallOfFame_EventScript_SetDesertUnderpassCommentReady
	clearflag FLAG_HIDE_LILYCOVE_MOTEL_GAME_DESIGNERS
	call EverGrandeCity_HallOfFame_EventScript_ResetEliteFour
	setflag FLAG_HIDE_SLATEPORT_CITY_STERNS_SHIPYARD_MR_BRINEY
	clearflag FLAG_HIDE_SS_TIDAL_CORRIDOR_MR_BRINEY
	clearflag FLAG_HIDE_MOSSDEEP_CITY_STEVENS_HOUSE_INVISIBLE_NINJA_BOY
	setvar VAR_STEVENS_HOUSE_STATE, 2
	setflag FLAG_HIDE_VICTORY_ROAD_ENTRANCE_WALLY
	clearflag FLAG_HIDE_VICTORY_ROAD_EXIT_WALLY
	clearflag FLAG_HIDE_SLATEPORT_CITY_HARBOR_SS_TIDAL
	clearflag FLAG_HIDE_LILYCOVE_HARBOR_SSTIDAL
	setflag FLAG_HIDE_SAFARI_ZONE_SOUTH_CONSTRUCTION_WORKERS
	clearflag FLAG_HIDE_SAFARI_ZONE_SOUTH_EAST_EXPANSION
	setflag FLAG_HIDE_LILYCOVE_CITY_RIVAL
	special UpdateTrainerFanClubGameClear
	call_if_unset FLAG_RECEIVED_SS_TICKET, EverGrandeCity_HallOfFame_EventScript_ReadyReceiveSSTicketEvent
	call_if_unset FLAG_RECEIVED_BELDUM, EverGrandeCity_HallOfFame_EventScript_ShowStevensHouseBeldum
	setflag FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM
	setflag FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_BEDROOM
	call_if_eq VAR_DEX_UPGRADE_JOHTO_STARTER_STATE, 0, EverGrandeCity_HallOfFame_EventScript_ReadyDexUpgradeEvent
	return

EverGrandeCity_HallOfFame_EventScript_ResetDefeatedEventLegendaries::
	clearflag FLAG_DEFEATED_MEW
	clearflag FLAG_DEFEATED_LATIAS_OR_LATIOS
	clearflag FLAG_DEFEATED_DEOXYS
	clearflag FLAG_DEFEATED_LUGIA
	clearflag FLAG_DEFEATED_HO_OH
	@ Project Grounded: verslagen (niet gevangen) Rayquaza's komen terug, anders kan de Delta Episode niet beginnen
	specialvar VAR_RESULT, Grounded_CaughtRayquaza
	call_if_eq VAR_RESULT, FALSE, EverGrandeCity_HallOfFame_EventScript_ResetRayquaza
	call_if_unset FLAG_CAUGHT_SHINY_RAYQUAZA, EverGrandeCity_HallOfFame_EventScript_ResetShinyRayquaza
	@ Project Grounded: een verslagen (niet gevangen) Zarude zit na de League weer in de ruine van Fortree Jungle
	call_if_unset FLAG_CAUGHT_ZARUDE, EverGrandeCity_HallOfFame_EventScript_ResetZarude
	@ Project Grounded: Ogerpon-quest. Verslagen (niet gevangen) Loyal Three en Ogerpon komen terug
	call_if_unset FLAG_CAUGHT_OKIDOGI, EverGrandeCity_HallOfFame_EventScript_ResetOkidogi
	call_if_unset FLAG_CAUGHT_MUNKIDORI, EverGrandeCity_HallOfFame_EventScript_ResetMunkidori
	call_if_unset FLAG_CAUGHT_FEZANDIPITI, EverGrandeCity_HallOfFame_EventScript_ResetFezandipiti
	call_if_unset FLAG_CAUGHT_OGERPON, EverGrandeCity_HallOfFame_EventScript_ResetOgerpon
	@ Project Grounded: Volcanion (Stoomeiland) verschijnt na de League; verslagen (niet gevangen) komt hij terug
	call_if_unset FLAG_CAUGHT_VOLCANION, EverGrandeCity_HallOfFame_EventScript_ResetVolcanion
	@ Project Grounded: Tapu-eiland en Fullmoon Island; verslagen (niet gevangen) komen ze terug
	call_if_unset FLAG_CAUGHT_TAPU_KOKO, EverGrandeCity_HallOfFame_EventScript_ResetTapuKoko
	call_if_unset FLAG_CAUGHT_TAPU_LELE, EverGrandeCity_HallOfFame_EventScript_ResetTapuLele
	call_if_unset FLAG_CAUGHT_TAPU_BULU, EverGrandeCity_HallOfFame_EventScript_ResetTapuBulu
	call_if_unset FLAG_CAUGHT_TAPU_FINI, EverGrandeCity_HallOfFame_EventScript_ResetTapuFini
	call_if_unset FLAG_CAUGHT_CRESSELIA, EverGrandeCity_HallOfFame_EventScript_ResetCresselia
	return

